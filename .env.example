# Copy to .env and adjust: cp .env.example .env
# All variables are documented in docs/configuration.md.
# Secrets do NOT go here: they live in ./secrets/ and are mounted as Docker secrets (compose.yaml).

# --- Zotero -------------------------------------------------------------------
# "user" for your personal library, "group" for a group library
ZOTERO_LIBRARY_TYPE=user
# User ID (https://www.zotero.org/settings/keys) or group ID (number in the group URL)
ZOTERO_LIBRARY_ID=1234567
# Collection key from the web library URL (.../collections/ABCD2345); leave empty for the whole library
ZOTERO_COLLECTION_KEY=ABCD2345
ZOTERO_INCLUDE_SUBCOLLECTIONS=true
# bibtex or biblatex
BIB_FORMAT=bibtex

# --- ShareLaTeX / Overleaf ----------------------------------------------------
# Project git URL as shown under project menu -> Git (the "git@" username is fine; never add the token)
SHARELATEX_GIT_URL=https://git@sharelatex.example.edu/git/0123456789abcdef01234567
SHARELATEX_BIB_PATH=references.bib
# SHARELATEX_GIT_USERNAME=git
# SHARELATEX_GIT_BRANCH=master
# SHARELATEX_COMMIT_MESSAGE=Update bibliography from Zotero
# SHARELATEX_COMMIT_AUTHOR_NAME=Zotero Sync
# SHARELATEX_COMMIT_AUTHOR_EMAIL=zotero-sync@localhost

# --- Optional tuning ----------------------------------------------------------
# SYNC_DEBOUNCE_SECONDS=30
# SYNC_SAFETY_INTERVAL_SECONDS=3600
# LOG_LEVEL=info
