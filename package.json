{
  "name": "zotero-sharelatex-sync",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Event-driven sync of a Zotero library or collection into a ShareLaTeX/Overleaf project via the git bridge.",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "start": "bun src/index.ts",
    "once": "bun src/index.ts once",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test",
    "lint:docker": "hadolint Dockerfile"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
